# Port the API server listens on
PORT=4000

# Origin allowed to make requests to this API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Where the frontend is actually deployed — used to build the links sent in
# verification/reset-password emails (see services/mail/templates.js).
# Defaults to http://localhost:5173 for local dev. In production, set this
# to the deployed frontend's URL (e.g. https://your-app.vercel.app), with
# no trailing slash.
FRONTEND_URL=http://localhost:5173

# Set this to switch /api/chat from the mock provider to the real Anthropic
# provider automatically. Leave empty to keep using the mock response.
# Never commit a real key.
ANTHROPIC_API_KEY=

# Claude model to use once ANTHROPIC_API_KEY is set. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# Free-tier fallback for /api/chat, used only when ANTHROPIC_API_KEY is
# unset — Groq's OpenAI-compatible API. Get a key at https://console.groq.com.
# Never commit a real key.
GROQ_API_KEY=

# Groq model to use once GROQ_API_KEY is set. Defaults to openai/gpt-oss-20b
# (a fast, free, instruction-tuned model available on Groq's free tier —
# check https://console.groq.com/docs/models for the current catalog, as
# Groq's free-tier model lineup changes over time).
GROQ_MODEL=

# Set this (and run with NODE_ENV=production) to send real verification/
# reset emails via Resend instead of the console-log + dev-outbox provider.
# Uses Resend's shared onboarding@resend.dev sender — no domain verification
# needed, but on Resend's free tier it can only deliver to the email address
# the Resend account itself was signed up with. Never commit a real key.
RESEND_API_KEY=

# The app's database — a Supabase/Postgres connection string, e.g.
# postgresql://USER:PASSWORD@HOST:5432/postgres
# Any special characters in the password (!, ?, @, /, #, etc.) must be
# percent-encoded (e.g. "!" -> "%21", "?" -> "%3F") or the URI won't parse.
# See db/postgresClient.js and db/postgresSchema.js.
DATABASE_URL=

# Path to a local SQLite file used ONLY by the dev-only email outbox (see
# db/devOutboxDb.js) — lets local testing read back verification/reset
# links without a real mail provider. Has nothing to do with the app's
# real database above. Defaults to server/data/dev-outbox.db when unset.
DATABASE_PATH=

# Number of reverse-proxy hops to trust when resolving the real client IP
# from X-Forwarded-For (see config/env.js and middleware/rateLimiters.js).
# A local dev server has no proxy in front of it, so that's 0.
#
# In production, the request path is browser -> Vercel (rewrites /api/* to
# Render) -> Cloudflare (in front of Render) -> Render's own internal
# proxy -> this app, which is 4 hops end to end (client, Vercel,
# Cloudflare, Render internal) — set TRUST_PROXY_HOPS=4 on Render. This
# number was reached empirically while debugging inconsistent production
# rate-limit behavior, not confirmed exhaustively against Render's own
# logs — see the Security section of the README for why the IP-based rate
# limits are treated as best-effort rather than the primary defense.
#
# Defaults to 1 when NODE_ENV=production, 0 otherwise, which is almost
# certainly too low for this app's actual deployment — set it explicitly.
TRUST_PROXY_HOPS=

# Rate limits below are all optional — sensible defaults are baked in (see
# config/env.js). Only set these to override them.
# Login attempts allowed per IP per window.
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW_MINUTES=
# Failed login attempts allowed per account (by email) per window,
# independent of IP — see the "IP limit is best-effort" note in the
# Security section of the README.
LOGIN_PER_EMAIL_RATE_LIMIT_MAX=
LOGIN_PER_EMAIL_RATE_LIMIT_WINDOW_MINUTES=
# Account registrations allowed per IP per window.
REGISTER_RATE_LIMIT_MAX=
REGISTER_RATE_LIMIT_WINDOW_MINUTES=
# Password reset requests allowed per IP per window.
FORGOT_PASSWORD_RATE_LIMIT_MAX=
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=
# Password reset requests allowed per target account (by email) per
# window, independent of IP — stops one victim email being flooded with
# reset emails from many different IPs.
FORGOT_PASSWORD_PER_EMAIL_RATE_LIMIT_MAX=
FORGOT_PASSWORD_PER_EMAIL_RATE_LIMIT_WINDOW_MINUTES=
# Verification email resends allowed per IP per window.
RESEND_VERIFICATION_RATE_LIMIT_MAX=
RESEND_VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=
# Same as above, but per target account (by email) instead of IP.
RESEND_VERIFICATION_PER_EMAIL_RATE_LIMIT_MAX=
RESEND_VERIFICATION_PER_EMAIL_RATE_LIMIT_WINDOW_MINUTES=
# Chat messages allowed per logged-in user per window.
CHAT_RATE_LIMIT_MAX=
CHAT_RATE_LIMIT_WINDOW_MINUTES=

# Cost caps (also optional, also defaulted — see config/env.js
# aiUsageCaps). These bound total AI-provider usage, separately from the
# rate limits above which only bound request speed.
# Open conversations allowed per user at once.
MAX_CONVERSATIONS_PER_USER=
# Real AI replies allowed per user per rolling 24h window.
MAX_AI_MESSAGES_PER_USER_PER_DAY=
# Real AI replies allowed across all users combined per rolling 24h window
# — a global kill switch for this demo's free-tier provider quota.
MAX_AI_CALLS_PER_DAY=
