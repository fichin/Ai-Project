# Port the API server listens on
PORT=4000

# Origin allowed to make requests to this API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Set this to switch /api/chat from the mock provider to the real Anthropic
# provider automatically. Leave empty to keep using the mock response.
# Never commit a real key.
ANTHROPIC_API_KEY=

# Claude model to use once ANTHROPIC_API_KEY is set. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# Path to the local SQLite database file. Defaults to server/data/app.db when unset.
DATABASE_PATH=
