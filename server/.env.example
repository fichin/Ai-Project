# Port the API server listens on
PORT=4000

# Origin allowed to make requests to this API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Where the frontend is actually deployed — used to build the links sent in
# verification/reset-password emails (see services/mail/templates.js).
# Defaults to http://localhost:5173 for local dev. In production, set this
# to the deployed frontend's URL (e.g. https://your-app.vercel.app), with
# no trailing slash.
FRONTEND_URL=http://localhost:5173

# Set this to switch /api/chat from the mock provider to the real Anthropic
# provider automatically. Leave empty to keep using the mock response.
# Never commit a real key.
ANTHROPIC_API_KEY=

# Claude model to use once ANTHROPIC_API_KEY is set. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# Free-tier fallback for /api/chat, used only when ANTHROPIC_API_KEY is
# unset — Groq's OpenAI-compatible API. Get a key at https://console.groq.com.
# Never commit a real key.
GROQ_API_KEY=

# Groq model to use once GROQ_API_KEY is set. Defaults to openai/gpt-oss-20b
# (a fast, free, instruction-tuned model available on Groq's free tier —
# check https://console.groq.com/docs/models for the current catalog, as
# Groq's free-tier model lineup changes over time).
GROQ_MODEL=

# Set this (and run with NODE_ENV=production) to send real verification/
# reset emails via Resend instead of the console-log + dev-outbox provider.
# Uses Resend's shared onboarding@resend.dev sender — no domain verification
# needed, but on Resend's free tier it can only deliver to the email address
# the Resend account itself was signed up with. Never commit a real key.
RESEND_API_KEY=

# The app's database — a Supabase/Postgres connection string, e.g.
# postgresql://USER:PASSWORD@HOST:5432/postgres
# Any special characters in the password (!, ?, @, /, #, etc.) must be
# percent-encoded (e.g. "!" -> "%21", "?" -> "%3F") or the URI won't parse.
# See db/postgresClient.js and db/postgresSchema.js.
DATABASE_URL=

# Path to a local SQLite file used ONLY by the dev-only email outbox (see
# db/devOutboxDb.js) — lets local testing read back verification/reset
# links without a real mail provider. Has nothing to do with the app's
# real database above. Defaults to server/data/dev-outbox.db when unset.
DATABASE_PATH=
